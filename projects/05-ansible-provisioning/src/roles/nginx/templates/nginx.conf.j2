# {{ ansible_managed }}
#
# このファイルは roles/nginx/templates/nginx.conf.j2 から
# Ansibleのtemplateモジュールによって自動生成されている。
# {{ '{{' }} ... {{ '}}' }} の部分(Jinja2変数)が、実行時に実際の値へ置き換わる。

server {
    listen {{ nginx_listen_port }} default_server;
    listen [::]:{{ nginx_listen_port }} default_server;

    server_name {{ nginx_server_name }};
    root {{ nginx_document_root }};
    index index.html;

    access_log /var/log/nginx/portfolio-site.access.log;
    error_log  /var/log/nginx/portfolio-site.error.log;

    location / {
        try_files $uri $uri/ =404;
    }
}
