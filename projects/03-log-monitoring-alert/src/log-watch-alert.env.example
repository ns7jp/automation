# log-watch-alert 設定ファイルのサンプル
# ---------------------------------------------------------------------------
# 実際に使うときは、同じディレクトリに .env という名前でコピーしてから
# 値を書き換える。
#
#   cp log-watch-alert.env.example .env
#
# systemdの EnvironmentFile= からこのファイルを読み込む想定のため、
# "KEY=VALUE" の形式を厳守すること(値をクォートで囲まない・行頭に
# 余計な空白を入れない)。Webhook URLなどの秘匿情報を含むため、
# 配置後は必ず chmod 600 で権限を絞ること(詳細は 03-build-guide.md)。
# ---------------------------------------------------------------------------

# 監視対象のログファイル
LOG_FILE=/var/log/app/error.log

# Slack Incoming Webhook の URL
# (Slack管理画面 [App管理 > Incoming Webhooks] で発行したものに置き換える)
SLACK_WEBHOOK_URL=<YOUR_SLACK_WEBHOOK_URL>

# 検知対象の正規表現(grep -E 形式。"|" で複数キーワードのOR条件を書ける)
ALERT_PATTERN=ERROR|CRITICAL

# スロットリングの時間(秒)。この秒数以内の再検知はまとめて1通にする
THROTTLE_SECONDS=300

# 状態ファイル(直近通知時刻・抑制件数)の保存先ディレクトリ
STATE_DIR=/var/lib/log-watch-alert

# Slack通知に表示するホスト名ラベル(省略時は `hostname` コマンドの結果を使用)
HOSTNAME_LABEL=web01
