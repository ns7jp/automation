# =====================================================================
# log-watch-alert.service
# ex14: systemdユニットを書く(解答例)
#
# 解答例は「1つの正解」ではありません。仕様を満たしていれば
# コメントの文面や、セクション内での行の順番は自由です。
# ただし「1つ1つの設定に、なぜそれが必要かをコメントで書き添える」書き方は
# 実務でも定番なので、真似することを勧めます。
# 設定ファイルは、書いた本人以外が数か月後に読むものだからです。
#
# 反映のしかた(実サーバーの場合):
#   sudo cp log-watch-alert.service /etc/systemd/system/
#   sudo systemctl daemon-reload          # ユニットファイルを読み直させる
#   sudo systemctl enable --now log-watch-alert
#   systemctl status log-watch-alert
#   journalctl -u log-watch-alert -n 30   # サービスが出したログを読む
# =====================================================================

# ---------------------------------------------------------------------
# [Unit] : サービスの説明と、他のサービスとの前後関係を書くセクション。
#          「起動する前」の話をここに書く。
# ---------------------------------------------------------------------
[Unit]
# Description : systemctl status や journalctl に表示される説明文。
#   ここが空だとユニット名しか出ず、他人が見たときに何のサービスか分からない。
Description=ログ監視・異常検知アラート通知サービス

# After : 起動の「順序」だけを指定する。network-online.target は
#   「ネットワークが実際に使える状態になった」ことを表す目印。
#   このサービスは異常検知時に外部へ通知を送るため、ネットワークが
#   整う前に起動して通知に失敗する、という事態を避けたい。
After=network-online.target

# Wants : 「一緒に起動してほしい」という弱い依存関係。
#   After は順序を決めるだけで、相手を起動する効果は無い。
#   そのため network-online.target を使いたいときは、この2行をセットで書く。
#   (Requires にすると「相手が失敗したらこちらも起動しない」という強い依存になる)
Wants=network-online.target

# ---------------------------------------------------------------------
# [Service] : 何をどう動かすかを書く、ユニットファイルの本体。
#             「起動している間」の話をここに書く。
# ---------------------------------------------------------------------
[Service]
# Type=simple : ExecStart で起動したプロセスがフォアグラウンドで
#   動き続けること自体を「サービスが動いている状態」とみなすモード。
#   ログ監視スクリプトは tail -F などで常駐し続けるので、これが適している。
#   逆に、スクリプトが自分をバックグラウンドへ回して終了してしまうと、
#   systemd は「サービスが終わった」と判断してしまう。
Type=simple

# ExecStart : 起動するコマンド。必ず絶対パス(/ から始まるパス)で書く。
#   systemd はログインシェルを介さずにプロセスを起動するため、
#   PATH やカレントディレクトリを当てにできないからである。
ExecStart=/opt/scripts/log-watch-alert.sh

# EnvironmentFile : KEY=VALUE 形式のファイルを読み込み、環境変数として
#   ExecStart のプロセスに渡す。監視対象のログのパスや通知先URLなど、
#   サーバーごとに変わる値をユニットファイルから切り離せる。
#
#   パスの直前の "-" は「このファイルが存在しなくても、エラーにせず起動する」
#   という意味。設定ファイルをまだ置いていない状態でも、スクリプト側の
#   既定値でとりあえず起動できるようにするために付けている。
EnvironmentFile=-/etc/default/log-watch-alert

# Restart=always : プロセスが終了したら、理由を問わず自動的に再起動する。
#   監視サービスは「黙って止まっている」ことが最大の事故なので、
#   正常終了(終了ステータス0)であっても立ち上げ直す always を選ぶ。
#   (異常終了のときだけ再起動したい場合は on-failure を使う)
Restart=always

# RestartSec : 再起動するまでの待ち時間(秒)。
#   0 にすると、起動に失敗するスクリプトを猛烈な勢いで再実行し続け、
#   CPU とログを食い潰す。数秒〜十数秒の間隔を必ず入れておく。
RestartSec=10

# User : どのユーザー権限でスクリプトを動かすか。
#   /var/log 配下のログを読むため、ここでは root にしている。
#   実務では権限を絞るのが原則なので、専用ユーザーを作って
#   ログの読み取り権限だけを与える形にできるとなおよい(発展課題1)。
User=root

# StandardOutput / StandardError : プロセスの出力の行き先。
#   journal を指定すると、標準出力も標準エラー出力も journald
#   (systemdのログ収集の仕組み)に取り込まれ、
#   journalctl -u log-watch-alert でまとめて追える。
#   スクリプト側でログファイルの管理を作り込まなくてよくなるのが利点。
StandardOutput=journal
StandardError=journal

# ---------------------------------------------------------------------
# [Install] : systemctl enable したときの扱いを書くセクション。
#             このセクションが無いと enable しても何も起こらない。
# ---------------------------------------------------------------------
[Install]
# WantedBy=multi-user.target : multi-user.target は「通常のサーバーとして
#   起動し終えた状態」を表す目印。ここに紐づけておくと、enable 実行時に
#   シンボリックリンクが作られ、サーバーを再起動しても自動的に立ち上がる。
WantedBy=multi-user.target
