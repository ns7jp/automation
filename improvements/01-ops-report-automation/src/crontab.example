# =====================================================================
# crontab.example
# 改善案件No.1: 月次運用報告書の自動生成 - cron登録例
#
# 使い方:
#   1. レポート生成サーバーで、ops_report.sh の実行権限を持つユーザーで
#        crontab -e
#   2. エディタが開いたら、下の設定行(コメント行を除く)を貼り付けて保存する
#   3. `crontab -l` で登録内容を確認する
#
# 書式: 分 時 日 月 曜日 実行するコマンド
#        0  6  1  *  *   コマンド
#
# 各フィールドの意味:
#   分(0-59) 時(0-23) 日(1-31) 月(1-12) 曜日(0-7、0と7は日曜)
#   「*」は「その項目を絞り込まない=毎回」を意味する
#
# 【なぜ「毎月1日」なのか】
#   ops_report.sh は引数を省略すると「前月」を対象に集計する。
#   月初に流せば、前月の1日〜末日のログがすべて出そろった状態で
#   集計できる(月末に流すと、その日の分がまだ足りない)。
#
# 【なぜ収集(05:00)とレポート生成(06:00)を分けるのか】
#   ・collect_logs.sh が各サーバーからログを集める
#   ・その1時間後に ops_report.sh が集計する
#   間隔を空けておくことで、ネットワークが遅くて収集に時間が
#   かかった場合でも、集計が「ログが途中までしか無い状態」で
#   走ってしまう事故を防げる。
# =====================================================================

# --- 環境変数(cronは対話ログイン時と違い、最小限の環境しか持たない) ---
# PATHを明示しておかないと、rsync や curl が「見つからない」と言われる
# ことがある。cron絡みのトラブルで最も多い原因のひとつ。
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# --- 1. 毎月1日 AM5:00 : 各サーバーからバックアップログを収集する ---
0 5 1 * * /opt/ops-report/collect_logs.sh >> /var/log/ops-report/cron.log 2>&1

# --- 2. 毎月1日 AM6:00 : 前月分の月次運用報告書を生成し、Slackへ通知する ---
0 6 1 * * /opt/ops-report/ops_report.sh >> /var/log/ops-report/cron.log 2>&1

# =====================================================================
# 【移行期間中(並行運用)に使う設定例】
#   自動生成の結果を信用しきれないうちは、ファイルに保存せず
#   ドライラン(-n)で内容だけメールしておく、という運用もできる。
#   下の行のコメント(#)を外し、上の「2.」を一時的にコメントアウトする。
#
# 0 6 1 * * /opt/ops-report/ops_report.sh -n 2>/dev/null | mail -s "月次運用報告書(自動生成・確認用)" ops@example.com
# =====================================================================
