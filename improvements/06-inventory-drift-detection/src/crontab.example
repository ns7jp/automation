# =====================================================================
# crontab.example
# 改善案件No.6: サーバー台帳の自動収集・差分検知 - cron登録例
#
# cron(=Linuxで、決まった時刻・間隔に処理を自動実行するための仕組み)に
# 登録することで、「毎日誰も操作しなくても台帳が最新になる」状態を作る。
# これが本改善の中心にある考え方であり、「四半期に1度、人が8時間かけて
# 棚卸しする」運用を「毎日、人手0分」に置き換えている部分にあたる。
#
# 使い方:
#   1. 収集専用ユーザー(invadmin)で以下を実行する
#        crontab -e
#   2. エディタが開いたら、下のコメント以外の行を貼り付けて保存する
#   3. `crontab -l` で登録内容を確認する
#
# 書式: 分 時 日 月 曜日 実行するコマンド
# =====================================================================

# ---------------------------------------------------------------------
# cron実行時の環境変数
#
# cronから起動されるプロセスは、ログイン時とは違う最小限の環境で動く。
# 特に PATH が短いため、jq や ssh が「見つからない」と言われる事故が起きやすい。
# 明示的に指定しておくのが安全。
# ---------------------------------------------------------------------
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
SHELL=/bin/bash

# ---------------------------------------------------------------------
# 日次の構成情報収集・差分検知・台帳生成
#
# 毎日 05:30 に実行する。
#   - 業務開始前(始業が9時なら3時間以上前)に終わらせ、
#     出社時点で「昨日からの変更一覧」が読める状態にするため。
#   - 深夜0時台を避けているのは、バックアップ(構築パック案件No.2)や
#     ログローテーションなど、他の夜間バッチと時間帯をずらすため。
#     同時に走らせると、収集中にファイルが動いて余計な差分が出やすい。
#
# 標準出力・標準エラー出力は cron.log に追記する。
# スクリプト自体が起動できない致命的なトラブル(パス誤り・権限不足など)は
# スクリプト側のログには残らないため、cron側でも必ず記録しておく。
# ---------------------------------------------------------------------
30 5 * * * /opt/inventory-drift/run_daily.sh >> /var/log/inventory-drift/cron.log 2>&1

# ---------------------------------------------------------------------
# 【段階的に導入する場合の例】
#
# 導入初日からいきなり6台を毎日回すのではなく、
# まず1台だけを対象に数日動かして、通知の量や差分の内容を確かめるとよい。
# その期間は、以下のように --target を付けた収集だけを回す。
#
#30 5 * * * /opt/inventory-drift/collect_inventory.sh --target web01 >> /var/log/inventory-drift/cron.log 2>&1
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# 【週次で台帳をGitにコミットしたい場合の例(発展)】
#
# 台帳(ledger.md)をGitリポジトリに置いて毎週コミットすると、
# 「台帳そのものの変更履歴」がGitのログとして残せる。
# 構築パック案件No.6(CI/CD)まで進んだ人向けの発展課題。
#
#0 6 * * 1 cd /opt/inventory-drift/reports && git add -A && git commit -m "chore: 週次台帳更新 $(date +\%F)" >> /var/log/inventory-drift/cron.log 2>&1
#
# ※ crontab の中では "%" が改行として扱われる特殊文字なので、
#    date のフォーマット指定は "\%F" のようにバックスラッシュで
#    エスケープする必要がある(cron特有のハマりどころ)。
# ---------------------------------------------------------------------
